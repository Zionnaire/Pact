# Same as .gitignore, but explicitly re-includes files EAS needs to see
# that git doesn't: local signing credentials (credentialsSource: "local"
# in eas.json), and .env — EAS Update bundles using .env directly (eas.json
# build-profile `env` only applies to `eas build`, not `eas update` — see
# app.config.ts), and a gitignored .env is otherwise silently absent from
# the archive, which is exactly what caused EXPO_PUBLIC_API_URL to fall
# back to its default on a prior update. Frontend/.env only ever holds
# EXPO_PUBLIC_-prefixed values, which are public/client-embedded by
# definition — nothing secret is exposed by including it here.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env*.local
!.env.example
*.tsbuildinfo
/ios
/android

!credentials.json
!credentials/
!credentials/*.jks
!.env
