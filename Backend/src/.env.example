# ── Server
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:8081
APP_DEEP_LINK=https://pact.app

# ── MongoDB (must be a replica set — Atlas gives you this by default — the
# reveal transaction requires it)
MONGODB_URI=mongodb+srv://your_user:your_password@your-cluster.mongodb.net/pact

# ── JWT
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_string
JWT_THERAPIST_SECRET=replace_with_a_third_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Operator-only routes (manual bonded-tier grants) — leave unset to
# disable those routes entirely
ADMIN_SECRET=

# ── Cloudinary (voice notes + avatars). Leave unset to disable media upload
# endpoints (everything else still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Twilio SMS (optional — the free `link` invite channel works without it)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Groq (one free-tier key covers both features below)
GROQ_API_KEY=

# Tone-check + theme extraction, via Groq's OpenAI-compatible chat
# completions endpoint (llama-3.3-70b-versatile). Leave GROQ_API_KEY unset
# to disable AI endpoints (everything else still works). Override AI_API_KEY
# only if you want a different key/provider than transcription below.
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TONE_CHECK_DAILY_LIMIT=20

# ── Voice transcription — disabled by default. Defaults to Groq's
# OpenAI-compatible endpoint (whisper-large-v3, free tier) instead of paid
# OpenAI. Point TRANSCRIPTION_BASE_URL at api.openai.com/v1 later if you
# want real Whisper instead.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3

# ── Paystack (Nigeria payments) — disabled by default. Test-mode keys are
# free; only real charges take a fee. Leave PAYMENTS_ENABLED=false and use
# the ADMIN_SECRET-gated manual grant route until you're ready.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Expo Push Notifications (free)
EXPO_ACCESS_TOKEN=

# ── Email — Microsoft Graph app-only auth (free with any Microsoft 365 /
# Outlook account). Requires an Azure AD app registration with an
# admin-consented Mail.Send *application* permission (not delegated).
# Leave unset to disable password reset and email invites — the link/SMS
# invite channels and normal login still work without it.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
SUPPORT_EMAIL=
